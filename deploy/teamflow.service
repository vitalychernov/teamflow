[Unit]
Description=TeamFlow Backend
After=network.target

[Service]
User=vchernov
WorkingDirectory=/home/vchernov/teamflow
ExecStart=/usr/bin/java \
  -Xms32m \
  -Xmx128m \
  -XX:MetaspaceSize=48m \
  -XX:MaxMetaspaceSize=96m \
  -XX:+UseSerialGC \
  -XX:ReservedCodeCacheSize=16m \
  -XX:TieredStopAtLevel=1 \
  -Xss256k \
  -Djava.security.egd=file:/dev/./urandom \
  -jar /home/vchernov/teamflow/backend/target/teamflow-backend-0.0.1-SNAPSHOT.jar
EnvironmentFile=/home/vchernov/teamflow/.env
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
